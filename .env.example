# Copy to .env.local for local development. Never commit real values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Set in Vercel project settings; never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_INSTITUTION_DOMAIN=iitgn.ac.in
# Campus email feed (server-only). AI_PROVIDER is "gemini" or "anthropic";
# set the matching key and the model ID to use.
AI_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
AI_MODEL=
